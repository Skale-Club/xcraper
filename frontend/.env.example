# Required
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Origin of the backend API. Leave EMPTY when the API is served from the same
# origin as the SPA (Vercel rewrites, the docker-compose nginx proxy, or the Vite
# dev proxy): requests then use relative /api/... paths.
# Only set it when frontend and backend live on different domains,
# e.g. https://api.example.com (and add the frontend origin to the backend's
# FRONTEND_URL / CORS_ALLOWED_ORIGINS).
VITE_API_URL=

# Public origin of the SPA, used for OAuth / password-reset redirect URLs.
# Optional: defaults to the origin the page was loaded from, which is correct
# unless you serve the app behind an alias you don't want users to see.
VITE_APP_URL=

# Cloudflare Turnstile site key (sign-up / login captcha). The allowed domains
# are configured in the Cloudflare dashboard, not here.
VITE_TURNSTILE_SITE_KEY=

# Optional fallback. You can now store this in admin system settings instead.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional fallback. You can now store this in admin system settings instead.
VITE_SENTRY_DSN=

# NOTE: VITE_* values are compiled into the bundle at build time. In Docker they
# are build args (see docker-compose.yml); on Vercel, project env vars at build.
