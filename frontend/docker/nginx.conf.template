# Rendered by the nginx image entrypoint (envsubst on /etc/nginx/templates/*.template).
# Only ${BACKEND_UPSTREAM} and ${DNS_RESOLVER} are substituted; nginx's own $variables are left alone.
#
# Mirrors vercel.json: /api/* -> backend, /assets/* immutable, everything else
# without a file extension -> index.html (SPA fallback).

# Use the scheme the edge proxy (Traefik) saw, falling back to this hop's own.
map $http_x_forwarded_proto $xcraper_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS. With a variable in proxy_pass nginx resolves the
    # upstream per request (valid=10s), so a redeployed backend is picked up
    # without reloading nginx and nginx boots even if the backend is down.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $xcraper_backend ${BACKEND_UPSTREAM};

    server_tokens off;
    client_max_body_size 10m;   # matches express.json({ limit: '10mb' })

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Server-sent events: no buffering, no compression, long-lived.
    location ^~ /api/sse/ {
        proxy_pass http://$xcraper_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $xcraper_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location ^~ /api/ {
        proxy_pass http://$xcraper_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $xcraper_forwarded_proto;
        proxy_read_timeout 120s;   # searches / exports can run a while
    }

    # Hashed build output: cache forever. A missing file is a 404, never index.html.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The service worker and the HTML shell must always revalidate so a new
    # deploy is picked up (PWA autoUpdate).
    location ~* ^/(sw\.js|workbox-[^/]+\.js|registerSW\.js)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    # Any other path with a file extension is a real static file (icons, ...).
    location ~* \.[^/]+$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
    }

    # Everything else is a client-side route.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
