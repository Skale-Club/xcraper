# Variables consumed by docker-compose.yml (self-hosted / Coolify).
# Copy to .env for a local `docker compose up --build`; in Coolify paste these
# into the application's Environment Variables instead. Never commit real values.
# Full guide: docs/SELF-HOSTING.md. Domain checklist: docs/DOMAIN-CHANGE.md.
#
# Local development without Docker does NOT use this file: use backend/.env
# and frontend/.env (see their .env.example files).

# ---------------------------------------------------------------- public URLs
# Public https origin users type in the browser. No trailing slash.
FRONTEND_URL=https://xcraper.example.com
# Leave empty: the API is reached on the same origin through the nginx proxy.
BACKEND_URL=
# Extra CORS origins (comma-separated), e.g. the OLD domain during a migration.
CORS_ALLOWED_ORIGINS=
# Proxy hops in front of the API. 2 = Traefik -> nginx -> API (this compose file).
TRUST_PROXY=2
LOG_LEVEL=info

# ------------------------------------------------------------------- required
DATABASE_URL=postgresql://user:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APIFY_API_TOKEN=
APIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------- frontend (build time)
# Compiled into the JS bundle: changing any of these needs an image rebuild.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Same value as VITE_SUPABASE_ANON_KEY unless you set it separately (used by /api/keepalive).
SUPABASE_ANON_KEY=
# Leave both empty for the same-origin setup.
VITE_API_URL=
VITE_APP_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_SENTRY_DSN=

# ------------------------------------------------------------------- features
GOOGLE_PLACES_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENTS_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTIONS_WEBHOOK_SECRET=
# Machine-to-machine API used by Hermes (X-Service-Key). Fails closed when empty.
XCRAPER_SERVICE_KEY=
XCRAPER_SERVICE_USER_EMAIL=
# Xphere push. XPHERE_API_URL defaults to the canonical Xphere origin when empty.
XPHERE_API_URL=
XPHERE_API_KEY=
SUPER_ADMIN_EMAIL=
ADMIN_EMAIL=
KEEPALIVE_SECRET=
SENTRY_DSN=
HOMELAB_SCRAPER_URL=
HOMELAB_SCRAPER_CF_CLIENT_ID=
HOMELAB_SCRAPER_CF_CLIENT_SECRET=
HOMELAB_SCRAPER_MAX_TIME_SECONDS=
HOMELAB_SCRAPER_DEPTH=
