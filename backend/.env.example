# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xcraper
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
APIFY_API_TOKEN=your-apify-api-token
FRONTEND_URL=http://localhost:5173

# Required if you use these features
GOOGLE_PLACES_API_KEY=your-google-places-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PAYMENTS_WEBHOOK_SECRET=your-stripe-payments-webhook-secret
STRIPE_SUBSCRIPTIONS_WEBHOOK_SECRET=your-stripe-subscriptions-webhook-secret

# Shared secret for POST /api/webhooks/apify (sent as x-apify-webhook-secret
# header or ?secret= query). The webhook fails closed when unset — Apify run
# status updates will be rejected until this is configured.
APIFY_WEBHOOK_SECRET=your-apify-webhook-secret

# Machine-to-machine (Hermes) service API: X-Service-Key header for
# /api/service/*. Fails closed (503) when unset. XCRAPER_SERVICE_USER_EMAIL
# picks the user that service-triggered scrapes run as (defaults to the first
# admin when unset).
XCRAPER_SERVICE_KEY=
XCRAPER_SERVICE_USER_EMAIL=

# Recommended
ADMIN_EMAIL=admin@example.com
BACKEND_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Optional
SENTRY_DSN=
CREDITS_PER_SEARCH=1
CREDITS_PER_CONTACT=1

# Xphere integration (push scrape runs into an Xphere workspace as prospects)
# XPHERE_API_KEY is an xph_ token with the prospects:write scope, created in
# Xphere → Settings → API Keys. Leave XPHERE_API_KEY blank to disable the feature.
XPHERE_API_URL=https://xphere.app
XPHERE_API_KEY=

# Owner-only: the one account (compared case-insensitively, trimmed) that may see and
# run owner-only scrapers such as the homelab one. role === 'admin' is NOT enough.
SUPER_ADMIN_EMAIL=skale.club@gmail.com

# Homelab scraper (gosom/google-maps-scraper in web/API mode behind Cloudflare Access).
# All three of URL / CF_CLIENT_ID / CF_CLIENT_SECRET are required; when any is missing
# the "Google Maps (Homelab)" scraper reports "not configured" and nothing else is
# affected. The CF values are a Cloudflare Access service token, sent as the
# CF-Access-Client-Id / CF-Access-Client-Secret headers. Never commit real values.
HOMELAB_SCRAPER_URL=
HOMELAB_SCRAPER_CF_CLIENT_ID=
HOMELAB_SCRAPER_CF_CLIENT_SECRET=
# Engine-side time limit per job, in seconds (default 1800).
HOMELAB_SCRAPER_MAX_TIME_SECONDS=1800
# Scroll depth per query (default 10). Higher = more places, much slower.
HOMELAB_SCRAPER_DEPTH=10
